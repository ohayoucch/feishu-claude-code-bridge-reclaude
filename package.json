{
  "name": "lark-channel-bridge-reclaude",
  "version": "0.1.0",
  "description": "Feishu/Lark bot that bridges to Claude Code via reclaude (handles HTTPS_PROXY / CA / auth automatically). Fork of zarazhangrui/feishu-claude-code-bridge with first-class reclaude wrapper support.",
  "type": "module",
  "bin": {
    "lark-channel-bridge-reclaude": "./bin/lark-channel-bridge.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "commander": "^12.1.0",
    "https-proxy-agent": "^9.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "keywords": [
    "feishu",
    "lark",
    "claude",
    "claude-code",
    "reclaude",
    "anthropic",
    "cli",
    "channel",
    "bridge",
    "bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohayoucch/feishu-claude-code-bridge-reclaude.git"
  },
  "homepage": "https://github.com/ohayoucch/feishu-claude-code-bridge-reclaude#readme",
  "bugs": {
    "url": "https://github.com/ohayoucch/feishu-claude-code-bridge-reclaude/issues"
  },
  "license": "MIT"
}
